# MySQL read-only discovery connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=FM
MYSQL_USER=readonly_user
MYSQL_PASSWORD=your_password_here

# Discovery limits
MYSQL_POOL_SIZE=2
MYSQL_POOL_TIMEOUT_SECONDS=10
MYSQL_CONNECT_TIMEOUT_SECONDS=5
MYSQL_SAMPLE_ROWS=5
MYSQL_MAX_TABLES=200
MYSQL_QUERY_TIMEOUT_SECONDS=30
MYSQL_MAX_RESULT_ROWS=1000
MYSQL_OUTPUT_DIR=artifacts

# Optional structured SQL generation
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1
